      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_961851a525d449a58d88dac2e40e5c7d",
        "type": "ai",
        "content": "- 利润为负或剧烈波动 → 成长类用PS/EV/S"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_961851a525d449a58d88dac2e40e5c7d",
        "type": "ai",
        "content": "ales，周期类用正常化盈利/PB，不用静态PE"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_961851a525d449a58d88dac2e40e5c7d",
        "type": "ai",
        "content": "；\n"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_961851a525d449a58d88dac2e40e5c7d",
        "type": "ai",
        "content": "- 利润为正、增速>20%且可持续 → PEG、"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_961851a525d449a58d88dac2e40e5c7d",
        "type": "ai",
        "content": "DCF、EV/EBITDA；\n"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_961851a525d449a58d88dac2e40e5c7d",
        "type": "ai",
        "content": "- 利润成熟稳定 → PE、DCF、股息率；\n"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_961851a525d449a58d88dac2e40e5c7d",
        "type": "ai",
        "content": "- 重资产、价格驱动 → PB、EV/EBITDA"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_961851a525d449a58d88dac2e40e5c7d",
        "type": "ai",
        "content": "、重置成本。\n\n"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_961851a525d449a58d88dac2e40e5c7d",
        "type": "ai",
        "content": "**切换触发条件**：\n\n"
