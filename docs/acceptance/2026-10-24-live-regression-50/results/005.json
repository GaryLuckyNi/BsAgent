    [
      {
        "id": "msg_b961b948adb147b5a779428b936ebd8b",
        "type": "ai",
        "content": "1. **加杠杆的 31.25% 是上限估计**"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_b961b948adb147b5a779428b936ebd8b",
        "type": "ai",
        "content": "。"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_b961b948adb147b5a779428b936ebd8b",
        "type": "ai",
        "content": "现实中负债上升会推高利息，利息负担因子随之下降，"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_b961b948adb147b5a779428b936ebd8b",
        "type": "ai",
        "content": "实际 ROE 增幅小于此，同时偿债压力与破产风险"
