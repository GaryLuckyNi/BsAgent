      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_b961b948adb147b5a779428b936ebd8b",
        "type": "ai",
        "content": "无法还原 ROE；\n"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_b961b948adb147b5a779428b936ebd8b",
        "type": "ai",
        "content": "- 同业比较时应统一口径；年内有重大股权融资的公司"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_b961b948adb147b5a779428b936ebd8b",
        "type": "ai",
        "content": "，简单平均仍可能失真，需按增发时点加权。\n\n"
