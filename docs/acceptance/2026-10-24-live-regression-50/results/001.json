    [
      {
        "id": "msg_572abdf7d2634d0abe2b5117f68434a3",
        "type": "ai",
        "content": "# 市盈率（PE）与市净率（PB）的区别\n\n"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_572abdf7d2634d0abe2b5117f68434a3",
        "type": "ai",
        "content": "市盈率和市净率都是把“股价”放在分子上的相对估值"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_572abdf7d2634d0abe2b5117f68434a3",
        "type": "ai",
        "content": "指标，区别全在分母：**PE 用利润作分母，PB"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_572abdf7d2634d0abe2b5117f68434a3",
        "type": "ai",
        "content": " 用净资产作分母**。"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_572abdf7d2634d0abe2b5117f68434a3",
        "type": "ai",
        "content": "这一差别决定了它们看的是企业的两个不同侧面——一个是"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_572abdf7d2634d0abe2b5117f68434a3",
        "type": "ai",
        "content": "“赚多少钱”，一个是“有多少家底”。\n\n"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_572abdf7d2634d0abe2b5117f68434a3",
        "type": "ai",
        "content": "## 一、定义与公式\n\n"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_572abdf7d2634d0abe2b5117f68434a3",
        "type": "ai",
        "content": "**市盈率（PE）**：股价相对于每股收益的倍数"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_572abdf7d2634d0abe2b5117f68434a3",
        "type": "ai",
        "content": "，表示投资者为每一元净利润愿意支付的价格。\n\n"
      },
      {
        "langgraph_node": "synthesizer"
      }
    ],
    [
      {
        "id": "msg_572abdf7d2634d0abe2b5117f68434a3",
        "type": "ai",
        "content": "- PE = 股价 ÷ 每股收益（EPS）= 总"
