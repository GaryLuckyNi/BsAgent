# 线上必须使用 LangGraph 官方 PostgresSaver，禁止 memory/sqlite/none。
BS_AGENT_GRAPH_CHECKPOINTER_BACKEND=postgres

# 该字段直接传给 psycopg_pool.ConnectionPool，不能使用 SQLAlchemy 的
# postgresql+psycopg:// URL。密码应由 Secret Manager 注入，不要提交到仓库。
BS_AGENT_GRAPH_CHECKPOINT_POSTGRES_URL=postgresql://bs_agent:${POSTGRES_PASSWORD}@postgres:5432/bs_agent

# 业务 ORM 使用独立字段，可以保留 SQLAlchemy driver 前缀。
BS_AGENT_DATABASE_URL=postgresql+psycopg://bs_agent:${POSTGRES_PASSWORD}@postgres:5432/bs_agent
