# 复制为受管环境变量或 Secret Manager 配置，不要把真实值提交到仓库。

JWT_ISSUER=https://identity.example.com
JWT_AUDIENCE=bs-agent
JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# 浏览器端 OIDC Authorization Code + PKCE 公共配置，不要填写 client secret。
OIDC_AUTHORITY=https://identity.example.com
OIDC_CLIENT_ID=bs-agent-web
OIDC_SCOPE=openid profile
# 必须是纯 origin，用于浏览器 CSP 白名单，例如 https://identity.example.com。
OIDC_CONNECT_SRC=https://identity.example.com
PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_PASSWORD=replace-with-strong-password
# 三类 PostgreSQL 连接由 Secret Manager、Kubernetes Secret 或受管环境变量注入。
# URL 中的用户名和密码必须百分号编码；仓库只保留无效示例值。
BS_AGENT_DATABASE_URL=postgresql+psycopg://bs_agent:replace-with-url-encoded-password@postgres:5432/bs_agent
BS_AGENT_GRAPH_CHECKPOINT_POSTGRES_URL=postgresql://bs_agent:replace-with-url-encoded-password@postgres:5432/bs_agent
BS_AGENT_MEMORY_STORE_POSTGRES_URL=postgresql://bs_agent:replace-with-url-encoded-password@postgres:5432/bs_agent
REDIS_PASSWORD=replace-with-strong-password
REDIS_PASSWORD_URLENCODED=replace-with-strong-password
EXPERIENCE_MEMORY_RECALL_LIMIT=8

MINIO_ROOT_USER=bsagent-minio
MINIO_ROOT_PASSWORD=replace-with-strong-password
OCR_API_KEY=replace-with-internal-service-token

RAG_BASE_URL=http://host.docker.internal:8001
RAG_PROVIDER_REVISION=rag-service-2026.07
RAG_CONFIG_REVISION=a-share-research-v1
# 受管业务内容规则（JSON 数组）；默认未配置业务字段脱敏。
BS_AGENT_TOOL_CONTENT_RULES=[]
BS_AGENT_TOOL_OUTBOUND_RULES=[]
BS_AGENT_TOOL_CONTENT_INJECTION_ACTION=flag
# Admin 由外部 HTTPS 入口提供，运行服务不再匿名读取。
ADMIN_BASE_URL=https://admin.example.com
SKILL_REGISTRY_BASE_URL=https://admin.example.com
ADMIN_SERVICE_TOKEN_URL=https://identity.example.com/realms/research/protocol/openid-connect/token
ADMIN_SERVICE_CLIENT_ID=bsagent-runtime
ADMIN_SERVICE_CLIENT_SECRET=replace-with-runtime-client-secret
ADMIN_SERVICE_SCOPE=
# 若 IdP 使用 audience 请求参数，在此指定；否则由 IdP 客户端映射签发。
ADMIN_SERVICE_AUDIENCE=bsagent-admin-runtime
# Tushare MCP 完整地址在 Admin 的“市场数据源”页面配置。
# 以下变量只用于可选的额外通用 MCP Server；不需要时保持为空。
BS_AGENT_MCP_SERVER_URL=
BS_AGENT_MCP_SERVER_NAME=agent-mcp
MCP_SERVER_REVISION=local-dev
MCP_CONFIG_REVISION=default

DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
BS_AGENT_CONTEXT_COMPACTION_ENABLED=false
BS_AGENT_LLM_CONTEXT_WINDOW_TOKENS=131072

VISION_API_KEY=replace-with-vision-key
VISION_BASE_URL=https://vision-provider.example.com/v1
VISION_MODEL=replace-with-vision-model

OTEL_ENABLED=true
OTEL_TRACE_SAMPLE_RATIO=0.1
# 外部 Tempo、Jaeger 或其他兼容 OTLP/HTTP 的持久化后端基地址。
OBSERVABILITY_OTLP_ENDPOINT=http://host.docker.internal:4318
FRONTEND_PORT=8080

# 通用 MCP 仅在明确为公共第三方且提供官方文档域名时启用联网说明补全。
BS_AGENT_MCP_PUBLIC_DOCUMENTATION=false
BS_AGENT_MCP_DOCUMENTATION_DOMAINS=[]

# 任务持久化预算：仅影响新任务；审批等待计时，恢复/失败/未知派发不补发额度。
BS_AGENT_RUN_BUDGET_MODEL_CALLS=32
BS_AGENT_RUN_BUDGET_TOOL_CALLS=64
BS_AGENT_RUN_BUDGET_HTTP_REQUESTS=512
BS_AGENT_RUN_BUDGET_REQUEST_BYTES=16777216
BS_AGENT_RUN_BUDGET_RESPONSE_WIRE_BYTES=134217728
BS_AGENT_RUN_BUDGET_RESPONSE_DECODED_BYTES=134217728
BS_AGENT_RUN_BUDGET_LIFETIME_SECONDS=1800
