BS_AGENT_DEEPSEEK_API_KEY=
# 可选；模型请求默认等待 60 秒，取值需大于 0 且不超过 300 秒。
# BS_AGENT_LLM_TIMEOUT_SECONDS=60
# 可选；推荐指向仓库 Python 3.11 虚拟环境的绝对路径。
# PYTHON=/absolute/path/to/BsAgent/.venv/bin/python
BS_AGENT_LANGFUSE_ENABLED=false
BS_AGENT_LANGFUSE_PUBLIC_KEY=
BS_AGENT_LANGFUSE_SECRET_KEY=
BS_AGENT_LANGFUSE_BASE_URL=http://localhost:3000
BS_AGENT_LANGFUSE_CONTENT_MODE=local_content
BS_AGENT_LANGFUSE_CAPTURE_REASONING=false
BS_AGENT_LANGFUSE_MAX_CONTENT_CHARS=20000
BS_AGENT_LANGFUSE_EVALUATION_ENABLED=true
BS_AGENT_LANGFUSE_DEEPSEEK_JUDGE_ENABLED=true
BS_AGENT_LANGFUSE_DEEPSEEK_JUDGE_TIMEOUT_SECONDS=30
BS_AGENT_LANGFUSE_ANNOTATION_ENABLED=true
BS_AGENT_LANGFUSE_ANSWER_REVIEW_THRESHOLD=0.7
BS_AGENT_LANGFUSE_SELECTION_CONFIDENCE_THRESHOLD=0.6
BS_AGENT_LANGFUSE_ANNOTATION_SAMPLE_RATE=0.05
BS_AGENT_LANGFUSE_ANNOTATION_RETRY_ATTEMPTS=3
# 可选；设为 true 后，本地 Langfuse 未就绪时 npm run dev 直接失败。
# BS_AGENT_DEV_LANGFUSE_REQUIRED=false
# 上下文压缩默认关闭；其余水位、保留轮次与摘要参数使用应用内默认策略。
BS_AGENT_CONTEXT_COMPACTION_ENABLED=false

# 权限恢复默认关闭；启用前需完成专用 PostgreSQL 并发验收。
BS_AGENT_RUNTIME_CAPABILITY_RECOVERY_ENABLED=false
# unknown：不提供替代搜索；public_supplement_only：允许符合来源约束的任务弹窗确认补充公开资料。
# 该配置不是自动搜索授权，也不让旧 Run 自动获得恢复资格。
BS_AGENT_PERMISSION_RECOVERY_SOURCE_POLICY=unknown

# 请按实际模型显式声明上下文窗口容量。
BS_AGENT_LLM_CONTEXT_WINDOW_TOKENS=131072
